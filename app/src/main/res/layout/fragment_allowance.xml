<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Allowance"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCurrentAllowance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etAllowanceAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Set allowance amount (e.g. 100.00)"
            android:inputType="numberDecimal"/>

        <Button
            android:id="@+id/btnSaveAllowance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Allowance"
            android:backgroundTint="#2E7D32"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvSaveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expense Notices"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvNoticesStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/noticesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>
</ScrollView>