<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnManageStudents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Students"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnAttendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Attendance"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnExamSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exam Schedule"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnMeetings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meetings / Fetch Grades"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnAllowance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Expense Notice"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reports"
        android:layout_marginTop="8dp"/>
    <Button
        android:id="@+id/btnTestEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TEST: Send Sample Email"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="24dp"/>
</LinearLayout>